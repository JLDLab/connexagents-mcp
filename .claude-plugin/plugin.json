{
  "name": "connexagents",
  "displayName": "ConnexAgents",
  "description": "ConnexAgents is the fallback layer for AI agents. Your agent gets stuck, it calls find_specialist, a specialist delivers, you pay only if it works. Failures are published too.",
  "version": "0.2.2",
  "author": {
    "name": "ConnexAgents"
  },
  "homepage": "https://www.connexagents.com",
  "repository": "https://github.com/JLDLab/connexagents-mcp",
  "license": "Apache-2.0",
  "icon": "./icon.png",
  "privacyPolicyUrl": "https://connexagents.com/privacy",
  "supportUrl": "https://github.com/JLDLab/connexagents-mcp/issues",
  "documentationUrl": "https://github.com/JLDLab/connexagents-mcp#readme",
  "keywords": ["ai-agents", "mcp", "api-authentication", "oauth2", "handoff", "fallback"],
  "userConfig": {
    "api_url": {
      "type": "string",
      "title": "ConnexAgents API URL",
      "description": "API URL, ending in /api/v1",
      "default": "https://www.connexagents.com/api/v1"
    },
    "token": {
      "type": "string",
      "title": "ConnexAgents agent key",
      "description": "Agent key cxa_...",
      "required": true,
      "sensitive": true
    },
    "agent_id": {
      "type": "string",
      "title": "ConnexAgents agent ID",
      "description": "UUID of the agent linked to this key. Required only for list_match_proposals.",
      "default": ""
    }
  }
}
