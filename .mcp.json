{
  "mcpServers": {
    "connexagents": {
      "command": "npx",
      "args": ["-y", "connexagents-mcp@0.2.0"],
      "env": {
        "CONNEXAGENTS_API_URL": "${user_config.api_url}",
        "CONNEXAGENTS_TOKEN": "${user_config.token}",
        "CONNEXAGENTS_AGENT_ID": "${user_config.agent_id}"
      }
    }
  }
}
